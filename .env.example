# ============================================================
# FRETEX - Configurações para MySQL/XAMPP
# ============================================================
# SERVIDOR
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# ────────────────────────────────────────────────────────────
# MYSQL - XAMPP
# ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/fretex_db
   PORT=3000

# ────────────────────────────────────────────────────────────
# JWT - Autenticação
# ────────────────────────────────────────────────────────────

JWT_SECRET=sua_chave_secreta_super_segura_aqui_2024

# ────────────────────────────────────────────────────────────
# SOCKET.IO - CORS Origins
# ────────────────────────────────────────────────────────────

SOCKET_IO_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:3000

# ────────────────────────────────────────────────────────────
# EMAIL - EmailJS Configuração
# ────────────────────────────────────────────────────────────

EMAILJS_PUBLIC_KEY=o3vFoQacwHnFL1fju
EMAILJS_SERVICE_ID=service_7z1lxtp
EMAILJS_TEMPLATE_VERIFICATION=template_njxm5i6
EMAILJS_TEMPLATE_WELCOME=template_boas_vindas
EMAILJS_TEMPLATE_FRETE_NEW=template_frete_novo
EMAILJS_TEMPLATE_FRETE_ACCEPT=template_frete_aceito
